{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Pi agents, skills, prompts, and workflow extensions",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "subagents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charliek/pi-extensions.git"
  },
  "scripts": {
    "validate": "node scripts/validate-resources.mjs",
    "sync-agents": "node scripts/sync-agents.mjs",
    "doctor": "node scripts/doctor.mjs",
    "allocate-plan": "node scripts/allocate-plan.mjs",
    "capture-scope": "node scripts/capture-scope.mjs",
    "build-scope-bundle": "node scripts/build-scope-bundle.mjs",
    "test": "node --test",
    "check": "npm run validate && npm test"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
